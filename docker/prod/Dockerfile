FROM node:23-alpine as build_step

WORKDIR /app

RUN corepack enable && corepack prepare yarn@4.6.0 --activate

COPY package.json yarn.lock* ./
RUN yarn install

COPY . /app

# Accept build arguments for environment variables
ARG VITE_APP_API_BASE_URL
ARG VITE_APP_MIRA_API_URL
ARG VITE_APP_FLUTTERWAVE_PUBLIC_KEY_TESTING
ARG VITE_APP_GITHUB_CLEINT_ID
ARG VITE_APP_EXCHANGE_RATE_KEY
ARG VITE_APP_DOCS_URL
ARG VITE_APP_DOCKER_EMAIL
ARG VITE_APP_DOCKER_PASSWORD
ARG VITE_APP_MONITORING_APP
ARG VITE_APP_ACTIVITY_LOGS_API_URL
ARG VITE_APP_MONITORING_API_URL
ARG VITE_APP_DATABASE_API_URL
ARG VITE_APP_MLOPS_API_URL
ARG VITE_APP_VERSION
ARG VITE_GOOGLE_CLIENT_ID
ARG VITE_REDIRECT_URI

# Set environment variables from build arguments
ENV VITE_APP_API_BASE_URL=$VITE_APP_API_BASE_URL
ENV VITE_APP_MIRA_API_URL=$VITE_APP_MIRA_API_URL
ENV VITE_APP_FLUTTERWAVE_PUBLIC_KEY_TESTING=$VITE_APP_FLUTTERWAVE_PUBLIC_KEY_TESTING
ENV VITE_APP_GITHUB_CLEINT_ID=$VITE_APP_GITHUB_CLEINT_ID
ENV VITE_APP_EXCHANGE_RATE_KEY=$VITE_APP_EXCHANGE_RATE_KEY
ENV VITE_APP_DOCS_URL=$VITE_APP_DOCS_URL
ENV VITE_APP_DOCKER_EMAIL=$VITE_APP_DOCKER_EMAIL
ENV VITE_APP_DOCKER_PASSWORD=$VITE_APP_DOCKER_PASSWORD
ENV VITE_APP_MONITORING_APP=$VITE_APP_MONITORING_APP
ENV VITE_APP_ACTIVITY_LOGS_API_URL=$VITE_APP_ACTIVITY_LOGS_API_URL
ENV VITE_APP_MONITORING_API_URL=$VITE_APP_MONITORING_API_URL
ENV VITE_APP_DATABASE_API_URL=$VITE_APP_DATABASE_API_URL
ENV VITE_APP_MLOPS_API_URL=$VITE_APP_MLOPS_API_URL
ENV VITE_APP_VERSION=$VITE_APP_VERSION
ENV VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID
ENV VITE_REDIRECT_URI=$VITE_REDIRECT_URI

RUN yarn build


FROM nginx:1.25-alpine as production 

COPY --from=build_step /app/dist /usr/share/nginx/html

COPY nginx.conf /etc/nginx/conf.d/default.conf 

EXPOSE 80 

CMD ["nginx", "-g", "daemon off;"]
